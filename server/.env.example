# is file ko copy kar ke ".env" naam se save karein aur apni details likhein

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=signature_events

# API server ka port
PORT=5000

# Website ka address (online karne par apna domain likhein, jaise https://signatureevents.pk)
# Ek se zyada hon to comma se alag karein
CORS_ORIGIN=http://localhost:5173

# Admin panel (/admin) ka password. Ise badal sakte hain — kam az kam 10 characters.
ADMIN_KEY=

# ================= EMAIL (Gmail) =================
# Gmail ke liye "App Password" chahiye (normal password nahi chalega):
# Google Account → Security → 2-Step Verification ON → "App passwords" → 16 letter password yahan likhein
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=signaturecatering10@gmail.com
SMTP_PASS=
MAIL_FROM="Signature Catering & Events" <signaturecatering10@gmail.com>
# Admin emails jin par har nayi enquiry jaye (comma se zyada likh sakte hain)
ADMIN_EMAIL=signaturecatering10@gmail.com

# ================= WHATSAPP (Meta WhatsApp Cloud API) =================
# Admin ke WhatsApp numbers jin par har nayi enquiry jaye (92 se shuru, comma se zyada)
ADMIN_WHATSAPP=923218255469
# Meta Business → WhatsApp → API Setup se milte hain. Khali hon to WhatsApp API band rahegi.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Meta mein approve shuda template ke naam
WA_TEMPLATE_ADMIN=new_enquiry
WA_TEMPLATE_CUSTOMER=enquiry_thank_you
WA_TEMPLATE_LANG=en

# Email / WhatsApp mein dikhne wali details
BRAND_NAME=Signature Catering & Event Management
BRAND_PHONE=0321 8255469
